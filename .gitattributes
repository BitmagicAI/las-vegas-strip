# Binary files go through Git LFS. Code, records and JSON data stay in plain git (they diff and merge).
# The runtime asset pack (~1 GiB of GLBs and textures from build/) is a GitHub Release download, not LFS:
# see docs/ASSETS.md and tools/release/fetch-assets.mjs.

# models
*.glb filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.vxl filter=lfs diff=lfs merge=lfs -text
*.splat filter=lfs diff=lfs merge=lfs -text
*.ply filter=lfs diff=lfs merge=lfs -text

